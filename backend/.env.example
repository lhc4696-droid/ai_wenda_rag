# 从阿里云百炼控制台获取，请勿把真实密钥提交到版本库。
DASHSCOPE_API_KEY=sk-your-api-key

# 个人模型配置的服务端加密密钥，不是模型 API Key；留空则停用个人密钥保存，系统模型仍可用。
# 安装依赖后，用 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 生成。
# 将结果仅保存到真实 .env，并与数据库一起安全备份；直接替换会导致旧 API Key 无法解密。
MODEL_CONFIG_SECRET=

# 自定义 API 的可选代理（测试连接、普通聊天、Coding 共用）。默认留空，继续公网直连检查。
# Clash Verge：查看实际 HTTP/Mixed 端口；这里的 7897 仅为示例，不要当成已检测到的端口。
# 两项必须同时填写或同时留空，仅支持后端所在机器上的无认证 HTTP/Mixed 代理。
# CUSTOM_MODEL_PROXY_URL=http://127.0.0.1:7897
# 白名单须与页面填写的完整 Base URL 匹配（含路径，不含 /chat/completions），多个用英文逗号分隔。
# CUSTOM_MODEL_PROXY_BASE_URLS=https://api.your-provider.com/v1
# 代理负责目标 DNS 与出站控制；只配置你信任的平台。未匹配的地址仍走公网直连检查。
CUSTOM_MODEL_PROXY_URL=
CUSTOM_MODEL_PROXY_BASE_URLS=

# 文本对话模型，可按百炼控制台中可用的模型名称修改。
# 默认调用 DashScope 多模态接口，纯文本聊天也使用该接口。
QWEN_MODEL=qwen3.8-27b

# 图片理解使用的视觉模型。留空时禁用图片上传，不影响文档/文字问答。
# 填写你所在百炼地域、账号可用的视觉模型 ID，例如 qwen-vl-plus；需自行确认权限。
QWEN_VISION_MODEL=
ATTACHMENT_MAX_BYTES=10485760
# 至少为 ATTACHMENT_MAX_BYTES + 3145728，含上传时的预览预留空间
ATTACHMENT_USER_QUOTA=209715200

# 本地 Qdrant 文字附件检索。首次访问资料模式时按需索引当前会话文档。
# 如暂时不用 RAG，可设为 false；仅普通聊天与旧兼容接口不依赖 Qdrant。
RAG_ENABLED=true
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=zhiyan_documents_v1
# Embedding 和 QWEN_MODEL 生成回答共用上面的 DASHSCOPE_API_KEY，不需第二把密钥。
# 与百炼账号所在地域、可用模型一致；更换模型或维度请使用新集合名重建索引。
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
# 服务器 Embedding 的独立每日请求批次上限；个人 API 的资料问答也受此限制。
# 文档索引与问题向量分别计次，缓存命中不重复生成文档向量。
RAG_EMBEDDING_REQUESTS_PER_DAY=100
RAG_EMBEDDING_GLOBAL_REQUESTS_PER_DAY=1000

# Coding Agent：复用上面的 Key。留空复用 QWEN_MODEL，模型必须支持多模态接口及 Function Calling。
QWEN_CODING_MODEL=
CODING_MAX_STEPS=12
CODING_TASK_TIMEOUT=300
CODING_TASKS_PER_DAY=20
CODING_GLOBAL_CONCURRENCY=4
# 旧 ZIP 工作台已下线；以下为保留代码的兼容配置，本地模式不使用沙箱。
# 本地文件夹模式不运行命令，不需要 Docker，修改此开关不会赋予执行权限。
CODING_SANDBOX_ENABLED=false
CODING_SANDBOX_IMAGE=zhiyan-coding-python:1
CODING_CHECK_TIMEOUT=45

# 多个前端地址使用英文逗号分隔。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 可选：定义助手行为。
SYSTEM_PROMPT=你是一个友好、准确的中文 AI 助手。回答应清晰、简洁；不确定时应明确说明。
# 默认与个人 API 共用频率、并发、超时保护；日额度仅限制默认模型。
# Embedding 子调用使用独立并发池，池大小和每用户分钟限制沿用下列配置。
# 全部有默认值，不要覆盖真实 .env 中的密钥。
CHAT_TIMEOUT=90
# 字符预算包含系统提示；不是精确 Token 数。
CHAT_CONTEXT_CHARS=40000
CHAT_MAX_OUTPUT_TOKENS=2048
CHAT_REQUESTS_PER_MINUTE=10
CHAT_REQUESTS_PER_DAY=100
CHAT_GLOBAL_REQUESTS_PER_DAY=1000
CHAT_USER_CONCURRENCY=1
CHAT_GLOBAL_CONCURRENCY=4
