# 从阿里云百炼控制台获取，请勿把真实密钥提交到版本库。
DASHSCOPE_API_KEY=sk-your-api-key

# 文本对话模型，可按百炼控制台中可用的模型名称修改。
QWEN_MODEL=qwen-plus

# 图片理解使用的视觉模型。留空时禁用图片上传，不影响文档/文字问答。
# 填写你所在百炼地域、账号可用的视觉模型 ID，例如 qwen-vl-plus；需自行确认权限。
QWEN_VISION_MODEL=
ATTACHMENT_MAX_BYTES=10485760
# 至少为 ATTACHMENT_MAX_BYTES + 3145728，含上传时的预览预留空间
ATTACHMENT_USER_QUOTA=209715200

# 本地 Qdrant 文字附件检索。首次访问资料模式时按需索引当前会话文档。
# 如暂时不用 RAG，可设为 false；仅普通聊天与旧兼容接口不依赖 Qdrant。
RAG_ENABLED=true
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=zhiyan_documents_v1
# Embedding 和 QWEN_MODEL 生成回答共用上面的 DASHSCOPE_API_KEY，不需第二把密钥。
# 与百炼账号所在地域、可用模型一致；更换模型或维度请使用新集合名重建索引。
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024

# Coding Agent：复用上面的 Key。留空复用 QWEN_MODEL，模型必须支持文本 Function Calling。
QWEN_CODING_MODEL=qwen-plus
CODING_MAX_STEPS=12
CODING_TASK_TIMEOUT=300
CODING_TASKS_PER_DAY=20
CODING_GLOBAL_CONCURRENCY=4
# 旧 ZIP 工作台已下线；以下为保留代码的兼容配置，本地模式不使用沙箱。
# 本地文件夹模式不运行命令，不需要 Docker，修改此开关不会赋予执行权限。
CODING_SANDBOX_ENABLED=false
CODING_SANDBOX_IMAGE=zhiyan-coding-python:1
CODING_CHECK_TIMEOUT=45

# 多个前端地址使用英文逗号分隔。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 可选：定义助手行为。
SYSTEM_PROMPT=你是一个友好、准确的中文 AI 助手。回答应清晰、简洁；不确定时应明确说明。
# 聊天调用保护。全部有默认值，不要覆盖真实 .env 中的密钥。
CHAT_TIMEOUT=90
# 字符预算包含系统提示；不是精确 Token 数。
CHAT_CONTEXT_CHARS=40000
CHAT_MAX_OUTPUT_TOKENS=2048
CHAT_REQUESTS_PER_MINUTE=10
CHAT_REQUESTS_PER_DAY=100
CHAT_GLOBAL_REQUESTS_PER_DAY=1000
CHAT_USER_CONCURRENCY=1
CHAT_GLOBAL_CONCURRENCY=4
